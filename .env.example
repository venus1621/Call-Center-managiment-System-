# --- Required ---
BOT_TOKEN=123456:ABC-from-BotFather
MONGO_URI=mongodb://127.0.0.1:27017/call_center_bot
# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Comma-separated Telegram IDs of supervisors (send /id to the bot to get yours)
ADMIN_IDS=

# --- Optional (defaults shown) ---
# Separate admin bot (create a 2nd bot in @BotFather). If empty, the admin panel lives in the main bot.
ADMIN_BOT_TOKEN=
TZ_NAME=Africa/Addis_Ababa
TZ_OFFSET=+03:00
# users allowed per slot by default: 1 or 2 (a supervisor can override per /addslots)
DEFAULT_SLOT_CAPACITY=1
# Configuration uses the standard 24-hour clock; Telegram displays Ethiopian time.
DEFAULT_SLOT_START=08:00
DEFAULT_SLOT_END=22:00
DEFAULT_SLOT_MINUTES=60
MAX_HOURS_PER_DAY=8
MIN_NOTICE_MIN=0
CANCEL_DEADLINE_MIN=60
ALARM_MIN_BEFORE=15
START_REMINDER_MIN=5
EARLY_START_MIN=10
AUTO_CLOSE_GRACE_MIN=10
DAILY_SUMMARY_HOUR=18
# true = bot also shows the account password to the agent who reserved it
SHOW_PASSWORD=false
